# Frontend environment variables
# API base resolution precedence:
# 1) If REACT_APP_API_BASE is set, the app uses `${REACT_APP_API_BASE}/api`.
# 2) Else if REACT_APP_BACKEND_URL is set, the app uses `${REACT_APP_BACKEND_URL}/api`.
# 3) Else default to `/api` (same-origin).

# Option A: Explicit base host:port to be prefixed before /api
# REACT_APP_API_BASE=http://localhost:5000

# Option B: Backend root host:port; the app appends /api
# REACT_APP_BACKEND_URL=http://localhost:5000

# Optional: Frontend URL (used by external tooling; not required by the app)
# REACT_APP_FRONTEND_URL=http://localhost:3000

# Optional: WebSocket URL (if backend adds WS in future)
# REACT_APP_WS_URL=ws://localhost:5000

# Node environment (development|production|test)
# REACT_APP_NODE_ENV=development

# Disable Next.js telemetry if used downstream tooling (no effect for CRA)
# REACT_APP_NEXT_TELEMETRY_DISABLED=1

# Enable source maps in production build (CRA uses GENERATE_SOURCEMAP)
# REACT_APP_ENABLE_SOURCE_MAPS=true

# Port for dev server (CRA respects PORT)
# PORT=3000

# Trust proxy (unused in CRA)
# REACT_APP_TRUST_PROXY=false

# Log level (app-specific; not enforced)
# REACT_APP_LOG_LEVEL=info

# Healthcheck path (unused in CRA)
# REACT_APP_HEALTHCHECK_PATH=/healthz

# Feature flags (comma-separated; app-specific)
# REACT_APP_FEATURE_FLAGS=

# Experiments toggle (app-specific)
# REACT_APP_EXPERIMENTS_ENABLED=false
